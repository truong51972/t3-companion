{
  "manifest_version": 3,
  "name": "T3 Companion",
  "short_name": "T3 Companion",
  "version": "0.1.0",
  "description": "T3 Code companion dashboard, Kanban and runner controls",
  "minimum_chrome_version": "142",
  "action": { "default_title": "T3 Companion", "default_popup": "popup.html" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["tabs", "sidePanel", "storage"],
  "host_permissions": ["https://api.github.com/*"]
}
